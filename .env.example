# ==========================================
# AEGIS NEXUS | ENVIRONMENT CONFIGURATION
# Team DA VINCI CODE
# ==========================================

# Port the Express + Vite server listens on (Render automatically provisions PORT)
PORT=3000

# Node environment mode: 'development' or 'production'
NODE_ENV=production

# Server-side Gemini API key for real AI reasoning (falls back to deterministic simulation when omitted)
GEMINI_API_KEY="AIzaSy..."

# Database URL: Optional for Render PostgreSQL; defaults to persistent SQLite if omitted
DATABASE_URL="postgres://user:password@hostname:5432/aegis_nexus_db"

# Public Application URL (injected by host or Cloud Run / Render)
APP_URL="https://aegis-nexus.onrender.com"
